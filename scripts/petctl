#!/usr/bin/env bash
# Send one command to the desktop pet. Silent no-op when the pet is not running,
# so it is safe to call from hooks, makefiles and shell functions.
#
#   petctl [-n NAME] ok | fail | work | done | climb | sleep | wake | meow | say TEXT | goto X | quit
#   petctl [-n NAME] run CMD...   run CMD, then send ok or fail based on its exit code
#
# The pipe lives at $XDG_RUNTIME_DIR/pet.fifo (or /tmp/pet.fifo). A pet started
# with --name NAME listens on pet-NAME.fifo: address it with -n NAME or PET_NAME.
# PET_FIFO overrides the path entirely.
#
# Needs python3. Each write is non-blocking and atomic (one command within
# PIPE_BUF), so a stopped pet or a full pipe drops the command instead of
# holding up the caller. Lines 2-10 above are the --help text.

name="${PET_NAME:-}"
if [ "$1" = "-n" ]; then name="$2"; shift 2; fi
dir="${XDG_RUNTIME_DIR:-/tmp}"
if [ -n "$name" ]; then fifo="${PET_FIFO:-$dir/pet-$name.fifo}"; else fifo="${PET_FIFO:-$dir/pet.fifo}"; fi

send() {
    [ -p "$fifo" ] || return 0
    # Neither open nor write may wait for a stopped pet. Keep each command
    # within PIPE_BUF so a write succeeds atomically or is dropped entirely.
    python3 -I -S - "$fifo" "$*" <<'PY'
import os
import stat
import sys

try:
    fd = os.open(sys.argv[1], os.O_WRONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
except OSError:
    sys.exit(0)
try:
    data = (sys.argv[2] + '\n').encode()
    if stat.S_ISFIFO(os.fstat(fd).st_mode) and len(data) <= os.fpathconf(fd, 'PC_PIPE_BUF'):
        os.write(fd, data)
except OSError:
    pass
finally:
    os.close(fd)
PY
    return 0
}

case "$1" in
    "" | -h | --help)
        sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    run)
        shift
        [ $# -gt 0 ] || { echo "petctl run: missing command" >&2; exit 2; }
        send work
        "$@"
        status=$?
        if [ $status -eq 0 ]; then send ok; else send fail; fi
        exit $status
        ;;
    *)
        send "$@"
        ;;
esac
