#!/usr/bin/env bash
# "Ship it" / "deploy": build an optimized binary and copy it, with petctl,
# into the user's tools folder.
#
#   scripts/ship [DEST]        default DEST: ~/Desktop/tools
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
dest="${1:-$HOME/Desktop/tools}"

cd "$root"
mkdir -p "$dest"
# The default build is the `auto` backend: GNOME Shell extension when it is
# running, X11 otherwise. One binary covers both.
zig build -Doptimize=ReleaseSafe
install -m 755 zig-out/bin/pet "$dest/pet"
install -m 755 scripts/petctl "$dest/petctl"
rm -f "$dest/pet-gnome" # from before the auto backend existed
echo "shipped $(git rev-parse --short HEAD 2>/dev/null || echo untracked) -> $dest/pet ($(du -h "$dest/pet" | cut -f1)) and $dest/petctl"
