{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/petctl work",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/petctl ok",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "msg=$(jq -r '.message // empty' 2>/dev/null); \"$CLAUDE_PROJECT_DIR\"/scripts/petctl meow; [ -n \"$msg\" ] && \"$CLAUDE_PROJECT_DIR\"/scripts/petctl say \"$msg\"; true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
